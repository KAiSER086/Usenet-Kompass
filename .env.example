# ==============================================================================
# 🧭 USENET-KOMPASS - UMGEBUNGSVARIABLEN (.env)
# Vorlage: Kopiere diese Datei nach .env ('cp .env.example .env')
# Dokumentation: https://github.com/KAiSER086/Usenet-Kompass
# ==============================================================================

# Benutzer- und Gruppen-ID deines Linux-Users (im Terminal via 'id -u' und 'id -g' ermitteln)
PUID=1000
PGID=1000

# Zeitzone
TZ=Europe/Berlin

# Basispfade für Konfiguration und Daten (Standard: relativ zum Installationsordner)
CONFIG_DIR=./config
DATA_DIR=./data

# --- WebUI & Port-Konfiguration ---
# Host-Ports für Web-Interfaces (hier anpassen, falls Ports auf deinem Server bereits belegt sind)
PORT_SABNZBD=8080
PORT_NZBGET=6789
PORT_PROWLARR=9696
PORT_SONARR=8989
PORT_RADARR=7878
PORT_JELLYFIN=8096
PORT_SEERR=5055

# --- VPN Konfiguration (nur relevant bei docker-compose.example.yml mit Gluetun) ---
VPN_SERVICE_PROVIDER=mullvad # z. B. mullvad, protonvpn, surfshark, ivpn, custom
VPN_TYPE=wireguard # wireguard oder openvpn
WIREGUARD_PRIVATE_KEY=dein-wireguard-private-key
WIREGUARD_ADDRESSES=10.64.0.1/32
SERVER_COUNTRIES=Netherlands,Germany
FIREWALL_OUTBOUND_SUBNETS=192.168.178.0/24 # Lokales Heimnetzwerk (bei Tailscale-Nutzung: 192.168.178.0/24,100.64.0.0/10)
